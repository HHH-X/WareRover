{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WareRover map configuration",
  "description": "Map JSON structure for WareRover simulator (core/gridmap.py, core/agvmanager.py)",
  "type": "object",
  "required": ["map", "boxes", "receivers", "wait_zones", "agvs"],
  "properties": {
    "map": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "boxes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["box_id", "position", "goods_ids", "size"],
        "properties": {
          "box_id": { "type": "integer", "minimum": 0 },
          "position": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 },
            "minItems": 2,
            "maxItems": 2
          },
          "goods_ids": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 },
            "minItems": 1
          },
          "size": { "type": "integer", "minimum": 1, "maximum": 2 }
        },
        "additionalProperties": false
      }
    },
    "receivers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["receiver_id", "position", "size"],
        "properties": {
          "receiver_id": { "type": "integer", "minimum": 0 },
          "position": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 },
            "minItems": 2,
            "maxItems": 2
          },
          "size": { "type": "integer", "minimum": 1, "maximum": 2 }
        },
        "additionalProperties": false
      }
    },
    "wait_zones": {
      "type": "array",
      "minItems": 1,
      "description": "One wait_zone per AGV; wait_zone_id must match agv_id.",
      "items": {
        "type": "object",
        "required": ["wait_zone_id", "position", "size"],
        "properties": {
          "wait_zone_id": { "type": "integer", "minimum": 0 },
          "position": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 },
            "minItems": 2,
            "maxItems": 2
          },
          "size": { "type": "integer", "minimum": 1, "maximum": 2 }
        },
        "additionalProperties": false
      }
    },
    "agvs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["agv_id", "size"],
        "properties": {
          "agv_id": { "type": "integer", "minimum": 0 },
          "size": { "type": "integer", "minimum": 1, "maximum": 2 }
        },
        "additionalProperties": false
      }
    },
    "obstacles": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "integer", "minimum": 0 },
        "minItems": 2,
        "maxItems": 2
      }
    }
  },
  "additionalProperties": false
}
